<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BMCL.Desktop.ViewModels"
             x:Class="BMCL.Desktop.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Border Background="Transparent" Padding="28,24">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="HeadlineSmall" Text="Global Settings" />
        <TextBlock Classes="BodyMedium"
                   Text="Configure memory and download behavior."
                   Foreground="{DynamicResource OnSurfaceVariant}" />
      </StackPanel>

      <ScrollViewer Grid.Row="1"
                    Margin="0,20,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Border Classes="Card Outlined" Padding="24">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Spacing="6">
                <TextBlock Classes="LabelMedium" Text="Minimum memory (MB)" />
                <NumericUpDown Value="{Binding MinMemoryMb, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="65536"
                               Increment="256" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="LabelMedium" Text="Maximum memory (MB)" />
                <NumericUpDown Value="{Binding MaxMemoryMb, Mode=TwoWay}"
                               Minimum="512"
                               Maximum="65536"
                               Increment="256" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Classes="LabelMedium" Text="Concurrent downloads" />
              <NumericUpDown Value="{Binding MaxConcurrentDownloads, Mode=TwoWay}"
                             Minimum="1"
                             Maximum="32"
                             Increment="1" />
            </StackPanel>

            <CheckBox Content="Use BMCLAPI mirror"
                      IsChecked="{Binding UseBmclApi, Mode=TwoWay}" />

            <StackPanel Spacing="6">
              <TextBlock Classes="LabelMedium" Text="Theme" />
              <ComboBox SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Follow system" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
              </ComboBox>
              <TextBlock Classes="LabelSmall"
                         Text="Follow system matches your desktop appearance."
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="LabelMedium" Text="Launcher directory" />
              <TextBlock Classes="BodySmall"
                         Text="{Binding RootDirectory}"
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <Grid Grid.Row="2"
            ColumnDefinitions="Auto,*"
            Margin="0,12,0,0">
        <Button Classes="Filled"
                Content="Save Settings"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Left" />
        <TextBlock Grid.Column="1"
                   Classes="LabelSmall"
                   Margin="12,0,0,0"
                   Text="{Binding Status}"
                   Foreground="{DynamicResource OnSurfaceVariant}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
