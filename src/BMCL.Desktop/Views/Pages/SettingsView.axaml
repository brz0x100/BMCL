<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BMCL.Desktop.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:material="using:CCSWE.Avalonia.Material"
             x:Class="BMCL.Desktop.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Border Background="Transparent" Padding="28,24">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="HeadlineSmall" Text="Global Settings" />
        <TextBlock Classes="BodyMedium"
                   Text="Configure memory and instance isolation."
                   Foreground="{DynamicResource OnSurfaceVariant}" />
      </StackPanel>

      <ScrollViewer Grid.Row="1"
                    Margin="0,20,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Border Classes="Card Outlined" Padding="24">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Spacing="6">
                <TextBlock Classes="LabelMedium" Text="Minimum memory (MB)" />
                <NumericUpDown Value="{Binding MinMemoryMb, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="65536"
                               Increment="256" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="LabelMedium" Text="Maximum memory (MB)" />
                <NumericUpDown Value="{Binding MaxMemoryMb, Mode=TwoWay}"
                               Minimum="512"
                               Maximum="65536"
                               Increment="256" />
              </StackPanel>
            </Grid>

            <material:Divider />

            <StackPanel Spacing="6">
              <TextBlock Classes="LabelMedium" Text="Default Isolation Strategy" />
              <ComboBox HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding SelectedIsolationStrategyIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Always" />
                <ComboBoxItem Content="Modded" />
                <ComboBoxItem Content="Never" />
              </ComboBox>
              <TextBlock Classes="LabelSmall"
                         Text="Automatically enable instance isolation for eligible instances when installing a new instance."
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <Grid Grid.Row="2"
            ColumnDefinitions="Auto,*"
            Margin="0,12,0,0">
        <Button Classes="Filled"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="ContentSave"
                                IconSize="16"
                                Foreground="{DynamicResource OnPrimary}" />
            <TextBlock Text="Save Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1"
                   Classes="LabelSmall"
                   Margin="12,0,0,0"
                   Text="{Binding Status}"
                   Foreground="{DynamicResource OnSurfaceVariant}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
