<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BMCL.Desktop.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:instances="using:BMCL.Core.Instances"
             x:Class="BMCL.Desktop.Views.Pages.InstancesView"
             x:DataType="vm:InstancesViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.InstanceGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ListBox.InstanceGrid ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="ListBox.InstanceGrid ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.InstanceGrid ListBoxItem:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.InstanceCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="ListBox.InstanceGrid ListBoxItem:selected Border.InstanceCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    </Style>
  </UserControl.Styles>

  <Border Background="Transparent" Padding="28,24">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="HeadlineSmall" Text="Instances" />
          <TextBlock Classes="BodyMedium"
                     Text="Manage Minecraft instances."
                     Foreground="{DynamicResource OnSurfaceVariant}" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="Text"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="Refresh"
                                IconSize="16"
                                Foreground="{DynamicResource Primary}" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid Grid.Row="1"
            Margin="0,20,0,0"
            ColumnDefinitions="*,Auto,Auto">
        <TextBox Classes="Outlined"
                 PlaceholderText="Search instances"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center" />
        <ComboBox Grid.Column="1"
                  SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}"
                  Width="170"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Sort instances">
          <ComboBoxItem Content="Name" />
          <ComboBoxItem Content="Last played" />
          <ComboBoxItem Content="Created" />
          <ComboBoxItem Content="Version" />
        </ComboBox>
        <Button Grid.Column="2"
                Classes="Outlined"
                Width="36"
                Height="36"
                Padding="0"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ToggleSortDirectionCommand}"
                ToolTip.Tip="Toggle sort direction">
          <icons:MaterialIcon Kind="{Binding SortIcon}"
                              IconSize="18"
                              Foreground="{DynamicResource OnSurfaceVariant}" />
        </Button>
      </Grid>

      <Grid Grid.Row="2" Margin="0,16,0,0">
        <Border Classes="Card Outlined"
                IsVisible="{Binding !HasInstances}">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="10">
            <icons:MaterialIcon Kind="ViewDashboard"
                                IconSize="48"
                                Foreground="{DynamicResource OnSurfaceVariant}" />
            <TextBlock Classes="TitleMedium"
                       Text="{Binding EmptyStateTitle}"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="BodySmall"
                       Text="{Binding EmptyStateMessage}"
                       Foreground="{DynamicResource OnSurfaceVariant}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <ListBox Classes="InstanceGrid"
                 ItemsSource="{Binding Instances}"
                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                 IsVisible="{Binding HasInstances}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemWidth="310" ItemHeight="92" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="instances:Instance">
              <Border Classes="InstanceCard" Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="48"
                          Height="48"
                          Background="{DynamicResource SurfaceContainerHighest}"
                          BorderBrush="{DynamicResource OutlineVariant}"
                          BorderThickness="1"
                          CornerRadius="8">
                    <icons:MaterialIcon Kind="Minecraft"
                                        IconSize="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Primary}" />
                  </Border>
                  <StackPanel Grid.Column="1"
                              Margin="12,0,0,0"
                              Spacing="4"
                              VerticalAlignment="Center">
                    <TextBlock Classes="TitleSmall"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <icons:MaterialIcon Kind="GamepadVariant"
                                          IconSize="14"
                                          Foreground="{DynamicResource OnSurfaceVariant}" />
                      <TextBlock Grid.Column="1"
                                 Classes="LabelSmall"
                                 Text="{Binding VersionId, StringFormat='Vanilla {0}'}"
                                 Foreground="{DynamicResource OnSurfaceVariant}"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap"
                                 ToolTip.Tip="{Binding VersionId}" />
                    </Grid>
                  </StackPanel>
                  <Button Grid.Column="2"
                          Width="32"
                          Height="32"
                          Padding="0"
                          Margin="4,0,0,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          BorderThickness="0"
                          ToolTip.Tip="Instance settings"
                          Click="OnInstanceSettingsClick">
                    <icons:MaterialIcon Kind="Cog"
                                        IconSize="18"
                                        Foreground="{DynamicResource OnSurfaceVariant}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <TextBlock Grid.Row="3"
                 Classes="LabelSmall"
                 Margin="2,12,0,0"
                 Text="{Binding Status}"
                 Foreground="{DynamicResource OnSurfaceVariant}" />
    </Grid>
  </Border>
</UserControl>
