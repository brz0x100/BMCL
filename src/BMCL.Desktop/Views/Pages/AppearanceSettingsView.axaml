<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BMCL.Desktop.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="BMCL.Desktop.Views.Pages.AppearanceSettingsView"
             x:DataType="vm:SettingsViewModel">
  <Border Background="Transparent" Padding="28,24">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="HeadlineSmall" Text="Appearance" />
        <TextBlock Classes="BodyMedium"
                   Text="Choose how the launcher looks."
                   Foreground="{DynamicResource OnSurfaceVariant}" />
      </StackPanel>

      <ScrollViewer Grid.Row="1"
                    Margin="0,20,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Border Classes="Card Outlined" Padding="24">
          <StackPanel Spacing="18">
            <StackPanel Spacing="6">
              <TextBlock Classes="LabelMedium" Text="Theme" />
              <ComboBox SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Follow system" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
              </ComboBox>
              <TextBlock Classes="LabelSmall"
                         Text="Follow system matches your desktop appearance."
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <Grid Grid.Row="2"
            ColumnDefinitions="Auto,*"
            Margin="0,12,0,0">
        <Button Classes="Filled"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="ContentSave"
                                IconSize="16"
                                Foreground="{DynamicResource OnPrimary}" />
            <TextBlock Text="Save Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1"
                   Classes="LabelSmall"
                   Margin="12,0,0,0"
                   Text="{Binding Status}"
                   Foreground="{DynamicResource OnSurfaceVariant}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
