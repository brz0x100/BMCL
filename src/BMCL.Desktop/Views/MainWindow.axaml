<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BMCL.Desktop.ViewModels"
        xmlns:material="using:CCSWE.Avalonia.Material"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:pages="using:BMCL.Desktop.Views.Pages"
        x:Class="BMCL.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BMCL"
        Width="1200"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Foreground="{DynamicResource OnSurface}">

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <pages:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
      <pages:InstancesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
      <pages:DownloadsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="ListBoxItem icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    </Style>
    <Style Selector="ListBoxItem:selected icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
    </Style>
    <Style Selector="ListBoxItem:disabled icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource OnSurface38}" />
    </Style>
  </Window.Styles>

  <Grid>
    <Border x:Name="ShadowBorder"
            Margin="24"
            CornerRadius="8"
            BoxShadow="0 1 3 0 #2E000000, 0 6 14 0 #4A000000"
            IsHitTestVisible="False" />
    <Border x:Name="RootBorder"
            Margin="24"
            Background="Transparent"
            ZIndex="1">
      <Grid RowDefinitions="40,*" ColumnDefinitions="80,*,Auto">
    <Border x:Name="TopBarBackground"
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Background="{DynamicResource Surface}"
            CornerRadius="8,8,0,0"
            ClipToBounds="True">
      <Panel Background="Transparent">
        <Border Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed" />
      <Grid Margin="16,0,0,0"
            ColumnDefinitions="Auto,*,Auto"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <icons:MaterialIcon Kind="Minecraft"
                              IconSize="20"
                              Foreground="{DynamicResource Primary}" />
          <TextBlock Classes="TitleMedium" Text="BMCL" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="0"
                    VerticalAlignment="Top">
          <Button Theme="{StaticResource CaptionButton}"
                  Click="OnMinimizeClick"
                  ToolTip.Tip="Minimize">
            <icons:MaterialIcon Kind="WindowMinimize"
                                IconSize="14"
                                Foreground="{DynamicResource OnSurfaceVariant}" />
          </Button>
          <Button Theme="{StaticResource CaptionButton}"
                  Click="OnMaximizeClick"
                  ToolTip.Tip="Maximize">
            <icons:MaterialIcon x:Name="MaximizeIcon"
                                Kind="WindowMaximize"
                                IconSize="14"
                                Foreground="{DynamicResource OnSurfaceVariant}" />
          </Button>
          <Button Theme="{StaticResource CaptionButton}"
                  Click="OnCloseClick"
                  ToolTip.Tip="Close">
            <icons:MaterialIcon Kind="WindowClose"
                                IconSize="14"
                                Foreground="{DynamicResource OnSurfaceVariant}" />
          </Button>
        </StackPanel>
      </Grid>
        <material:Divider VerticalAlignment="Bottom" />
      </Panel>
    </Border>

    <Border x:Name="ContentBackgroundBorder"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Background="{DynamicResource Surface}"
            CornerRadius="0,0,8,8" />

    <Border x:Name="SidebarBorder"
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource SurfaceContainerLow}"
            BorderBrush="{DynamicResource OutlineVariant}"
            BorderThickness="0,0,1,0"
            CornerRadius="0,0,0,8">
      <Grid RowDefinitions="*,Auto">
        <ListBox Classes="NavigationRail"
                 SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                 VerticalAlignment="Top">
          <ListBoxItem Tag="Home" ToolTip.Tip="Home">
            <icons:MaterialIcon Kind="Home" IconSize="20" />
          </ListBoxItem>
          <ListBoxItem Tag="Instances" ToolTip.Tip="Instances">
            <icons:MaterialIcon Kind="ViewDashboard" IconSize="20" />
          </ListBoxItem>
          <ListBoxItem Tag="Downloads" ToolTip.Tip="Downloads">
            <icons:MaterialIcon Kind="Download" IconSize="20" />
          </ListBoxItem>
        </ListBox>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,14"
                    Spacing="8"
                    HorizontalAlignment="Center">
          <Button Classes="Outlined"
                  Width="40"
                  Height="40"
                  Padding="0"
                  CornerRadius="20"
                  Foreground="{DynamicResource OnSurfaceVariant}"
                  ToolTip.Tip="Settings"
                  Click="OnOpenSettingsClick">
            <icons:MaterialIcon Kind="Cog"
                                IconSize="20"
                                Foreground="{DynamicResource OnSurfaceVariant}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1"
                    Grid.Column="1"
                    Content="{Binding CurrentPage}" />

    <Border x:Name="RightPanelBorder"
            Grid.Row="1"
            Grid.Column="2"
            Width="300"
            IsVisible="{Binding IsHomePage}"
            Background="{DynamicResource SurfaceContainerLow}"
            BorderBrush="{DynamicResource OutlineVariant}"
            BorderThickness="1,0,0,0"
            CornerRadius="0,0,8,0">
      <Grid Margin="20" RowDefinitions="*,Auto,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">
            <Border Classes="Card Outlined" Padding="20, 38, 20, 20">
              <StackPanel Spacing="14">
                <Border Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource PrimaryContainer}"
                        CornerRadius="14">
                  <icons:MaterialIcon Kind="AccountCircle"
                                      IconSize="34"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource OnPrimaryContainer}" />
                </Border>
                <StackPanel Spacing="3">
                  <TextBlock Classes="TitleMedium"
                             Text="{Binding AccountName}"
                             HorizontalAlignment="Center" />
                  <TextBlock Classes="LabelSmall"
                             Text="{Binding AccountTypeText}"
                             Foreground="{DynamicResource OnSurfaceVariant}"
                             HorizontalAlignment="Center" />
                </StackPanel>
                <Button Classes="Text"
                        Content="Manage Account"
                        HorizontalAlignment="Center"
                        Click="OnOpenAccountClick" />
              </StackPanel>
            </Border>

            <Border Classes="Card Outlined" Padding="20, 38, 20, 20">
              <StackPanel Spacing="14">
                <Border Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SurfaceContainerHighest}"
                        BorderBrush="{DynamicResource OutlineVariant}"
                        BorderThickness="1"
                        CornerRadius="14">
                  <icons:MaterialIcon Kind="ViewDashboard"
                                      IconSize="30"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource OnSurfaceVariant}" />
                </Border>
                <StackPanel Spacing="3">
                  <TextBlock Classes="TitleMedium"
                             Text="{Binding InstancesPage.DisplayName}"
                             HorizontalAlignment="Center" />
                  <TextBlock Classes="BodySmall"
                             Text="{Binding InstancesPage.DisplayVersion}"
                             Foreground="{DynamicResource OnSurfaceVariant}"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Center" />
                </StackPanel>
                <Button Classes="Text"
                        Content="Manage Instance"
                        HorizontalAlignment="Center"
                        Command="{Binding OpenInstancesCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Classes="Filled"
                Height="48"
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding CanLaunch}"
                Command="{Binding LaunchGameCommand}"
                ToolTip.Tip="Select an account and an installed instance, then launch.">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Play"
                                IconSize="18"
                                Foreground="{DynamicResource OnPrimary}" />
            <TextBlock Classes="LabelLarge"
                       Text="{Binding LaunchButtonText}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <TextBlock Grid.Row="2"
                   Classes="LabelSmall"
                   Margin="2,8,0,0"
                   Text="{Binding Status}"
                   Foreground="{DynamicResource OnSurfaceVariant}"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Grid.RowSpan="2"
            Grid.ColumnSpan="3"
            Background="#66000000"
            CornerRadius="8"
            IsVisible="{Binding IsDialogOpen}"
            ZIndex="10" />
    </Grid>
  </Border>

    <Border x:Name="EdgeBorder"
            Margin="24"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#33808080"
            RenderOptions.EdgeMode="Antialias"
            IsHitTestVisible="False"
            ZIndex="2" />

  <Grid x:Name="ResizeGripLayer"
        Margin="6"
        ColumnDefinitions="14,*,14"
        RowDefinitions="14,*,14">
    <Border x:Name="ResizeTopLeft" Grid.Row="0" Grid.Column="0" Background="Transparent" Tag="TopLeft" PointerPressed="OnResizePressed" />
    <Border x:Name="ResizeTop" Grid.Row="0" Grid.Column="1" Background="Transparent" Tag="Top" PointerPressed="OnResizePressed" />
    <Border x:Name="ResizeTopRight" Grid.Row="0" Grid.Column="2" Background="Transparent" Tag="TopRight" PointerPressed="OnResizePressed" />
    <Border x:Name="ResizeLeft" Grid.Row="1" Grid.Column="0" Background="Transparent" Tag="Left" PointerPressed="OnResizePressed" />
    <Border x:Name="ResizeRight" Grid.Row="1" Grid.Column="2" Background="Transparent" Tag="Right" PointerPressed="OnResizePressed" />
    <Border x:Name="ResizeBottomLeft" Grid.Row="2" Grid.Column="0" Background="Transparent" Tag="BottomLeft" PointerPressed="OnResizePressed" />
    <Border x:Name="ResizeBottom" Grid.Row="2" Grid.Column="1" Background="Transparent" Tag="Bottom" PointerPressed="OnResizePressed" />
    <Border x:Name="ResizeBottomRight" Grid.Row="2" Grid.Column="2" Background="Transparent" Tag="BottomRight" PointerPressed="OnResizePressed" />
  </Grid>
</Grid>
</Window>
