<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BMCL.Desktop.ViewModels"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:pages="using:BMCL.Desktop.Views.Pages"
        x:Class="BMCL.Desktop.Views.Dialogs.AccountWindow"
        x:DataType="vm:AccountViewModel"
        Title="Accounts"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Foreground="{DynamicResource OnSurface}"
        CanResize="False"
        Width="792"
        Height="524"
        ShowInTaskbar="False">
  <Grid Margin="24">
    <Border CornerRadius="8"
            BoxShadow="0 1 3 0 #2E000000, 0 6 14 0 #4A000000"
            IsHitTestVisible="False" />
    <Border Background="{DynamicResource Surface}"
            BorderBrush="#33808080"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
      <Panel>
        <pages:AccountView />

        <Button Theme="{StaticResource CaptionButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ToolTip.Tip="Close"
                Click="OnCloseClick">
          <icons:MaterialIcon Kind="WindowClose"
                              IconSize="14"
                              Foreground="{DynamicResource OnSurfaceVariant}" />
        </Button>
      </Panel>
    </Border>
  </Grid>
</Window>
