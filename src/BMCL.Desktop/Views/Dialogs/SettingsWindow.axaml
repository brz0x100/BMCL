<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BMCL.Desktop.ViewModels"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:pages="using:BMCL.Desktop.Views.Pages"
        x:Class="BMCL.Desktop.Views.Dialogs.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Foreground="{DynamicResource OnSurface}"
        CanResize="False"
        Width="1032"
        Height="654"
        ShowInTaskbar="False">
  <Grid Margin="24">
    <Border CornerRadius="8"
            BoxShadow="0 1 3 0 #2E000000, 0 6 14 0 #4A000000"
            IsHitTestVisible="False" />
    <Border Background="{DynamicResource Surface}"
            BorderBrush="#33808080"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
      <Panel>
        <Grid ColumnDefinitions="96,*">
          <Border Grid.Column="0"
                  Background="{DynamicResource SurfaceContainerLow}"
                  BorderBrush="{DynamicResource OutlineVariant}"
                  BorderThickness="0,0,1,0"
                  CornerRadius="8,0,0,8">
            <ListBox Classes="NavigationRail"
                     Margin="0,40,0,0"
                     SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
              <ListBoxItem Tag="Global Settings" ToolTip.Tip="Global Settings">
                <icons:MaterialIcon Kind="Cog" IconSize="20" />
              </ListBoxItem>
              <ListBoxItem Tag="Java Management" ToolTip.Tip="Java Management">
                <icons:MaterialIcon Kind="Coffee" IconSize="20" />
              </ListBoxItem>
            </ListBox>
          </Border>

          <Grid Grid.Column="1">
            <pages:SettingsView IsVisible="{Binding IsGlobalSection}" />
            <pages:JavaSettingsView IsVisible="{Binding IsJavaSection}" />
          </Grid>
        </Grid>

        <Button Theme="{StaticResource CaptionButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ToolTip.Tip="Close"
                Click="OnCloseClick">
          <icons:MaterialIcon Kind="WindowClose"
                              IconSize="14"
                              Foreground="{DynamicResource OnSurfaceVariant}" />
        </Button>
      </Panel>
    </Border>
  </Grid>
</Window>
